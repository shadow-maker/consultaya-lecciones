# consultaya-lecciones: valores locales de desarrollo. Copia este archivo a `.env` y ajusta.
# (`consultaya-deploy/scripts/dev-up` también genera `.env` a partir de este archivo.)

# Base de datos de desarrollo. Reemplaza USUARIO y PASSWORD por los de tu Postgres local
# (si tu usuario no tiene contraseña, usa `postgresql+psycopg://USUARIO@localhost:5432/...`).
DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@localhost:5432/consultaya_lecciones

# Base solo para tests: el nombre debe empezar con `consultaya_` y terminar en `_test`.
# Los tests BORRAN y recrean su esquema.
TEST_DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@localhost:5432/consultaya_lecciones_test

# Mismo valor en los 3 servicios (usuarios, lecciones y progreso). En AWS: aleatorio de 64+ caracteres.
JWT_SECRET=dev-secret-cambiar

LOG_LEVEL=INFO
